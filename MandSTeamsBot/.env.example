# --- Microsoft Teams bot (from the Azure / Entra app registration) ---
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=
PORT=3978
# true = connect out to Teams over a WebSocket (no public URL needed; for trials).
# The bot must be set to "Socket mode" in the Teams Developer Portal to match.
SOCKET_MODE=false

# --- Send check-ins from a real person's account (optional) ---
# true = check-ins arrive from the signed-in person's own Teams account, in their
# normal one-to-one chats, instead of from the bot. Run "npm run signin" once first.
# The bot app is then only needed by the admins, for commands and the digest.
SEND_AS_USER=false
# With SEND_AS_USER: true tells colleagues the check-in is automated. false writes
# as the sender in the first person and never mentions automation; the assistant
# then hands the chat to the sender rather than answer if asked whether it is a bot.
DISCLOSE_AUTOMATION=true
# How often to look for replies, in seconds.
POLL_SECONDS=20

# --- Claude ---
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5 (best summaries). claude-haiku-5-5 is the cheapest.
# CLAUDE_MODEL=claude-opus-5-5

# --- Who is in charge ---
# Comma-separated work emails (Teams sign-in addresses) of the people allowed to
# nominate staff, set profiles and receive the digest. Nobody else can.
ADMIN_EMAILS=cto@yourcompany.com,ceo@yourcompany.com
COMPANY_NAME=Your Company

# --- Timing ---
# The schedule is set from the bot chat ("schedule 17:00", "schedule off"), not here.
# Times you give there are read in this timezone.
TIMEZONE=Europe/London
# Minutes to wait for a reply before the one chase message
CHASE_AFTER_MINUTES=45
# Minutes of silence after which a conversation with replies is closed and its
# summary posted to the admins
IDLE_CLOSE_MINUTES=30
# Leadership digest: 7:30 pm
DIGEST_CRON=30 19 * * 1-5

# --- Behaviour ---
# Hard cap on bot questions per person per day, so it never feels like an interrogation.
MAX_BOT_TURNS=6
# Where the SQLite database lives. Back this folder up; it holds every note.
DATA_DIR=./data
